# ──────────────────────────────────────────────────────────────────────────
# DESK mobile — variables d'environnement
# ──────────────────────────────────────────────────────────────────────────
# Copier en .env (gitignored) avant `expo start`.
#
# Les variables EXPO_PUBLIC_* sont exposées au JS client. Donc PAS de secrets.
# Pour des secrets, utiliser eas secret + accéder via process.env côté EAS Build.

# Supabase — projet partagé avec le web. Mêmes valeurs que packages/web/.env
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Sentry (optionnel, défini après setup Sentry)
# EXPO_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
