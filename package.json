{
  "name": "captiv-desk",
  "private": true,
  "version": "1.0.0",
  "description": "Captiv DESK — monorepo (web + mobile + shared)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@captiv/web",
    "dev:web": "npm run dev --workspace=@captiv/web",
    "dev:mobile": "npm run start --workspace=@captiv/mobile",
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=@captiv/web",
    "lint": "npm run lint --workspaces --if-present",
    "lint:fix": "npm run lint:fix --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist packages/*/.expo"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}
